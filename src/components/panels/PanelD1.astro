---
import { findingTrend, qualityKpi } from '../../data/quality';
import { band, linear, innerW, innerH, type Box } from '../../lib/chart';
import { pct, num } from '../../lib/format';
import Panel from '../ui/Panel.astro';
import Kpi from '../ui/Kpi.astro';
import Legend from '../ui/Legend.astro';

const box: Box = { w: 700, h: 240, top: 14, right: 8, bottom: 34, left: 32 };
const iw = innerW(box);
const ih = innerH(box);

const maxTotal = Math.max(...findingTrend.map((d) => d.closed + d.open));
const yMax = Math.ceil(maxTotal / 20) * 20;
const y = linear(0, yMax, ih, 0);
const gridValues = Array.from({ length: 5 }, (_, i) => (yMax / 4) * i);

// Grafik kecil terpisah untuk temuan terbuka — sumbu sendiri, bukan sumbu ganda.
const openMax = Math.max(...findingTrend.map((d) => d.open));
const stripH = 46;
const yOpen = linear(0, openMax, stripH, 2);

const last3 = findingTrend.slice(-3).reduce((s, d) => s + d.open, 0);
const prev3 = findingTrend.slice(-6, -3).reduce((s, d) => s + d.open, 0);
const rise = ((last3 - prev3) / prev3) * 100;
---

<Panel
  id="D1"
  title="Tren temuan inspeksi"
  question="Apakah mutu pekerjaan membaik atau memburuk?"
  source="Aplikasi inspeksi pada tablet, unggah langsung dari lokasi"
  freshness="realtime"
  aggregate
>
  <div class="kpi-row d1-kpi">
    <Kpi
      label="Bangunan lolos standar"
      value={pct(qualityKpi.passRate)}
      tone="kuning"
      note={`turun ${pct(qualityKpi.passRatePrev - qualityKpi.passRate)} dari kuartal lalu`}
    />
    <Kpi label="Temuan terbuka" value={num(qualityKpi.openFindings)} tone="merah" note="seluruh lokasi" />
    <Kpi label="Berkategori berat" value={num(qualityKpi.severeOpen)} tone="merah" note="mempengaruhi struktur atau keselamatan" />
  </div>

  <figure class="chart">
    <svg viewBox={`0 0 ${box.w} ${box.h}`} class="chart__svg" role="img"
      aria-label={`Temuan inspeksi per bulan, ${findingTrend[0].month} sampai ${findingTrend[findingTrend.length - 1].month}. Temuan terbuka naik ${pct(rise, 0)} dalam tiga bulan terakhir.`}>
      <g transform={`translate(${box.left},${box.top})`}>
        {
          gridValues.map((v) => (
            <>
              <line x1={0} x2={iw} y1={y(v)} y2={y(v)} class={v === 0 ? 'axis' : 'grid'} />
              <text x={-7} y={y(v) + 4} class="tick tick--y">{v}</text>
            </>
          ))
        }

        {
          findingTrend.map((d, i) => {
            const b = band(i, findingTrend.length, iw, 0.3);
            const total = d.closed + d.open;
            return (
              <g
                class="barg"
                tabindex="0"
                data-tip={`${d.month}\nDitutup\t${d.closed}\nTerbuka\t${d.open}\nTotal\t${total}`}
              >
                <rect x={b.x} y={y(d.closed)} width={b.w} height={ih - y(d.closed)} class="seg seg--closed" />
                <rect x={b.x} y={y(total)} width={b.w} height={y(d.closed) - y(total)} class="seg seg--open" />
                <text x={b.center} y={y(total) - 5} class="barlabel">{d.open}</text>
                <text x={b.center} y={ih + 15} class="tick tick--x">{d.month.split(' ')[0]}</text>
                <text x={b.center} y={ih + 26} class="tick tick--year">{d.month.split(' ')[1]}</text>
              </g>
            );
          })
        }
      </g>
    </svg>

    <div class="strip">
      <span class="strip__label">Temuan terbuka saja<br /><span class="muted">skala tersendiri, 0–{openMax}</span></span>
      <svg viewBox={`0 0 ${iw} ${stripH}`} class="strip__svg" role="img" aria-label={`Garis tren temuan terbuka, dari ${findingTrend[0].open} menjadi ${findingTrend[findingTrend.length - 1].open}.`}>
        <polyline
          class="strip__line"
          points={findingTrend.map((d, i) => `${band(i, findingTrend.length, iw, 0.3).center},${yOpen(d.open)}`).join(' ')}
        />
        {
          findingTrend.map((d, i) => (
            <circle cx={band(i, findingTrend.length, iw, 0.3).center} cy={yOpen(d.open)} r={2.4} class="strip__dot" />
          ))
        }
      </svg>
    </div>

    <figcaption class="chart__cap">
      <Legend
        items={[
          { label: 'Temuan ditutup', color: '#B9B9AC' },
          { label: 'Temuan masih terbuka', color: 'var(--red)' },
        ]}
      />
      <p class="chart__note">
        Temuan terbuka naik <strong class="t-red">{pct(rise, 0)}</strong> dalam tiga bulan terakhir
        ({prev3} → {last3} temuan). Kategori: berat memengaruhi struktur atau keselamatan, sedang memengaruhi fungsi,
        ringan menyangkut estetika dan kerapian.
      </p>
    </figcaption>
  </figure>
</Panel>

<style>
  .d1-kpi { grid-template-columns: repeat(3, 1fr); margin-bottom: var(--pad); }
  .chart { margin: 0; }
  .chart__svg { display: block; width: 100%; height: auto; }

  .grid { stroke: var(--line-soft); }
  .axis { stroke: var(--line); }

  .tick { font-family: var(--font-body); font-size: 10px; fill: var(--ink-3); }
  .tick--y { text-anchor: end; }
  .tick--x { text-anchor: middle; }
  .tick--year { text-anchor: middle; font-size: 8.5px; fill: var(--line); }

  .seg--closed { fill: #B9B9AC; }
  .seg--open { fill: var(--red); }

  .barlabel {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 11px;
    fill: var(--red-ink);
    text-anchor: middle;
  }

  .barg { cursor: default; }
  .barg:hover .seg, .barg:focus-visible .seg { fill-opacity: 0.82; }
  .barg:focus-visible { outline: none; }
  .barg:focus-visible .seg--closed { stroke: var(--ink); stroke-width: 1.5; }

  .strip {
    display: grid;
    grid-template-columns: 148px 1fr;
    gap: 10px;
    align-items: center;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--line-soft);
  }

  .strip__label { font-size: 0.6875rem; color: var(--ink-2); line-height: 1.3; }
  .strip__svg { display: block; width: 100%; height: auto; }
  .strip__line { fill: none; stroke: var(--red); stroke-width: 2; }
  .strip__dot { fill: var(--red); }

  .chart__cap {
    margin-top: 12px;
    padding-top: 11px;
    border-top: 1px solid var(--line-soft);
    display: grid;
    gap: 9px;
  }

  .chart__note { margin: 0; font-size: 0.75rem; color: var(--ink-2); line-height: 1.45; }
</style>
